# Vector store Day 6 (local Docker, xem docker-compose.yml)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:15433/day6_lab
# Strategy đã chọn ở Day 6: B = paragraph-aware chunking (cấu hình C = B + filter chương)
PG_STRATEGY=B
# Embedding phải trùng model đã dùng để index ở Day 6
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM cho agent (điền ở bước 4)
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
